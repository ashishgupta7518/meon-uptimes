SQLITE_DB_PATH=data/uptime.sqlite
SQLITE_WAL_ENABLED=true
SQLITE_BUSY_TIMEOUT_MS=5000

MONITORING_SCHEDULER_ENABLED=true
MONITOR_INITIAL_DELAY_MS=5000
MONITOR_INTERVAL_MS=60000
STATUS_PROBE_TIMEOUT_MS=0
SLOW_STATUS_PROBE_TIMEOUT_MS=0
SLOW_RESPONSE_MS=3000
STATUS_STALE_TTL_MS=1800000
MONITOR_DOWN_ALERT_COOLDOWN_MS=0

MONITOR_MEMORY_WARNING_THRESHOLD=85
MONITOR_MEMORY_DOWN_THRESHOLD=95
MONITOR_DISK_WARNING_THRESHOLD=85
MONITOR_DISK_DOWN_THRESHOLD=95
MONITOR_CPU_WARNING_THRESHOLD=85
MONITOR_CPU_DOWN_THRESHOLD=95
MONITOR_MISSING_CPU_STATUS=warning

APP_DASHBOARD_URL=http://localhost:5173/dashboard

/var/www/html/heartbeat
